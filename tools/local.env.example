# Copy to tools/local.env (not committed) and point these at your own installs.
# Android SDK with build-tools 36.0.0 and platforms/android-35 (also read by cloud/build.gradle.kts).
export ANDROID_SDK_ROOT='C:/path/to/android/sdk'
# Android NDK used to link libil2cpp.so (r28 tested). Windows form, il2cpp.exe takes it as is.
export NDK='C:\path\to\android\sdk\ndk\28.2.13676358'
# adb and the device serial for install-thor.sh.
export ADB='/c/path/to/android/sdk/platform-tools/adb.exe'
export ANDROID_SERIAL=''
